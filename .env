# Copy this file to .env and fill in real values. Never commit .env.

# Get a free key (no credit card) at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Which folder the agent is allowed to touch. It CANNOT read/write/run
# anything outside this folder. Defaults to ./workspace if not set.
WORKSPACE_DIR=./workspace

# Model to use. gemini-3.5-flash-lite is stable and cost-efficient.
# Google's model lineup changes often -- if you get a 404 "no longer
# available" error, check https://aistudio.google.com/apikey for models
# currently enabled on your account and update this.
MODEL=gemini-3.5-flash-lite

# Max tool-calling loops per task before giving up.
MAX_TURNS=25

# How long (seconds) to let a single shell command run before timing out.
COMMAND_TIMEOUT=60

# If "true", the agent writes files / runs commands WITHOUT asking for
# your approval each time. Leave "false" until you trust it.
AUTO_APPROVE=false
